# Push server for Diario Fitness. Copy to .env for local runs; on Render set
# these in the service's Environment tab. Never commit real values.

# "development" opens /docs and allows http://localhost:5173; anything else is production.
APP_ENV=development

# Supabase → Project settings → Database → Connection string (URI, "Session pooler").
# Empty = devices kept in memory (local tests only).
DATABASE_URL=postgresql://postgres.abcdefghijkl:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Web Push keys: python scripts/gen_vapid.py (once; new keys invalidate every subscription).
VAPID_PUBLIC_KEY=BExamplePublicKeyBase64Url
VAPID_PRIVATE_KEY=examplePrivateKeyBase64Url
# Contact for the push services (any address you read).
VAPID_SUBJECT=mailto:you@example.com

# Typed once in the app (Settings → Notifications) to register a phone. Long and random.
REGISTER_KEY=change-me-long-random-string
# Sent by the Supabase cron in the X-Cron-Secret header. Long and random.
CRON_SECRET=change-me-another-long-random-string

# Who may call the API from a browser (comma separated).
ALLOWED_ORIGINS=https://senseibonsai2k.github.io

# Optional: Sentry project DSN for this server (empty = off).
SENTRY_DSN=
