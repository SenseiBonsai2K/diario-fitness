# Prefix of every key the app stores on the phone (localStorage, IndexedDB).
# The preview build at /prova/ uses "diario-fitness-prova" so it never reads or
# writes the real diary's data. Not a secret.
VITE_KEY_PREFIX=diario-fitness

# Address of the push server (server/, on Render), e.g. https://diario-fitness-push.onrender.com.
# Not a secret. Empty = typed in the app (Settings → Notifications).
VITE_PUSH_SERVER=
